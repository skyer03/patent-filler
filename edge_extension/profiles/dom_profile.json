{
  "format": "patent-dom-profile-v1",
  "id": "patent-intranet-dom",
  "version": "dom-poc-v1",
  "page_fingerprint": {
    "required_markers": ["专利信息库", "基本信息"],
    "error_markers": ["错误页面", "页面加载中", "校验失败", "弹窗遮挡"]
  },
  "blocked_action_labels": ["保存", "提交", "返回", "删除", "新建下一条记录"],
  "fields": {
    "patent_no": {
      "kind": "text",
      "labels": ["专利号"],
      "selectors": ["input[name='ZL_ZLH']", "[data-m2-id='patent_no']", "input[name='patentNo']"]
    },
    "application_title": {
      "kind": "text",
      "labels": ["申请名称", "专利名称"],
      "selectors": ["input[name='ZL_NSQMC']", "[data-m2-id='application_title']", "input[name='applicationTitle']"]
    },
    "patent_type": {
      "kind": "radio",
      "labels": ["申请类型", "专利类型"],
      "selectors": ["table[id^='crgroup-']:not([id*='-innerCt'])", "[data-m2-id='patent_type']" ]
    },
    "application_date": {
      "kind": "date",
      "labels": ["申请受理日", "专利申请日"],
      "selectors": ["input[name='ZL_SQSLR']", "[data-m2-id='application_date']", "input[name='applicationDate']"]
    },
    "grant_date": {
      "kind": "date",
      "labels": ["授权公告日", "授权日"],
      "selectors": ["input[name='ZL_SQGGR']", "[data-m2-id='grant_date']", "input[name='grantDate']"]
    },
    "joint_application": {
      "kind": "checkbox",
      "labels": ["联合申请"],
      "selectors": ["[data-m2-id='joint_application']", "input[name='jointApplication']"]
    },
    "rights_holder_rows": {
      "kind": "table",
      "labels": ["专利权人表"],
      "selectors": ["[data-m2-id='rights_holder_rows']"],
      "table": {
        "row_selector": "tbody tr:not(.empty-row)",
        "value_selector": "td:nth-child(2) input",
        "add_selector": "[data-m2-id='rights_holder_add']",
        "new_input_selector": "tbody tr:last-child td:nth-child(2) input"
      }
    },
    "inventor_rows": {
      "kind": "table",
      "labels": ["发明人（含第一发明人）"],
      "selectors": ["[data-m2-id='inventor_rows']"],
      "table": {
        "row_selector": "tbody tr:not(.empty-row)",
        "value_selector": "td:nth-child(2) input",
        "add_selector": "[data-m2-id='inventor_add']",
        "new_input_selector": "tbody tr:last-child td:nth-child(2) input"
      }
    },
    "first_inventor_select": {
      "kind": "person",
      "labels": ["第一发明人"],
      "selectors": ["[data-m2-id='first_inventor_select']"],
      "person": {
        "search_selector": "#person-search",
        "result_selector": "#people-list .person",
        "choose_selector": "[data-person]",
        "readback_selector": "#selected-person",
        "readback_prefix": "已选择："
      }
    },
    "patentee_merge": {
      "kind": "text",
      "labels": ["专利权人合并"],
      "selectors": ["[data-m2-id='patentee_merge']"]
    },
    "inventor_merge": {
      "kind": "text",
      "labels": ["发明人合并"],
      "selectors": ["[data-m2-id='inventor_merge']"]
    }
  }
}
