{
  "format": "patent-dom-profile-v1",
  "id": "patent-intranet-dom",
  "version": "dom-poc-v3",
  "page_fingerprint": {
    "required_markers": ["专利信息库", "基本信息"],
    "error_markers": ["错误页面", "页面加载中", "校验失败", "弹窗遮挡"]
  },
  "blocked_action_labels": ["保存", "提交", "返回", "删除", "新建下一条记录"],
  "fields": {
    "patent_no": {
      "kind": "text",
      "labels": ["专利号"],
      "selectors": ["input[name='ZL_ZLH']", "[data-m2-id='patent_no']", "input[name='patentNo']"]
    },
    "application_title": {
      "kind": "text",
      "labels": ["申请名称", "专利名称"],
      "selectors": ["input[name='ZL_NSQMC']", "[data-m2-id='application_title']", "input[name='applicationTitle']"]
    },
    "patent_type": {
      "kind": "radio",
      "labels": ["申请类型", "专利类型"],
      "selectors": ["table[id^='crgroup-']:not([id*='-innerCt'])", "[data-m2-id='patent_type']" ]
    },
    "application_date": {
      "kind": "date",
      "labels": ["申请受理日", "专利申请日"],
      "selectors": ["input[name='ZL_SQSLR']", "[data-m2-id='application_date']", "input[name='applicationDate']"]
    },
    "grant_date": {
      "kind": "date",
      "labels": ["授权公告日", "授权日"],
      "selectors": ["input[name='ZL_SQGGR']", "[data-m2-id='grant_date']", "input[name='grantDate']"]
    },
    "joint_application": {
      "kind": "checkbox",
      "labels": ["联合申请"],
      "selectors": ["[data-m2-id='joint_application']", "input[name='jointApplication']"]
    },
    "rights_holder_rows": {
      "kind": "table",
      "labels": ["专利权人"],
      "selectors": ["table.je-field-childfunc"],
      "table": {
        "identity_selector": ".x-grid-cell-ZLQR_NAME",
        "identity_texts": ["单位名称"],
        "row_selector": "tr.x-grid-row",
        "value_selector": "td.x-grid-cell-ZLQR_NAME .x-grid-cell-inner",
        "add_selector": ".add-icon.add.fa-plus-circle",
        "add_within_table": true,
        "new_cell_selector": "td.x-grid-cell-ZLQR_NAME",
        "new_input_selector": "input[name='ZLQR_NAME']"
      }
    },
    "inventor_rows": {
      "kind": "table",
      "labels": ["发明人（含第一发明人）"],
      "selectors": ["table.je-field-childfunc"],
      "table": {
        "identity_selector": ".x-grid-cell-USERNAME",
        "identity_texts": ["姓名", "身份证号"],
        "row_selector": "tr.x-grid-row",
        "value_selector": "td.x-grid-cell-USERNAME .x-grid-cell-inner",
        "add_selector": ".add-icon.add.fa-plus-circle",
        "add_within_table": true,
        "new_cell_selector": "td.x-grid-cell-USERNAME",
        "new_input_selector": "input[name='USERNAME']"
      }
    },
    "first_inventor_select": {
      "kind": "person",
      "labels": [],
      "selectors": ["input[name='ZL_DYFMRXM']"],
      "person": {
        "mode": "direct"
      }
    },
    "patentee_merge": {
      "kind": "text",
      "labels": [],
      "selectors": ["input[name='ZL_ZLQRHB']"]
    },
    "inventor_merge": {
      "kind": "text",
      "labels": [],
      "selectors": ["input[name='ZL_FMRHB']"]
    }
  }
}
